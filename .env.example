# Copy to .env and fill in your settings.

# Exact public origin used in the browser, including scheme and port
# if applicable. For a reverse-proxy deployment, use your HTTPS domain (https://band.example.com).
APP_URL=http://localhost:3000

# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# OR
#
# openssl rand -hex 32
# Keep this secret safe: it is needed to decrypt saved SMTP credentials.
APP_SECRET=

# Used only when provisioning a new database.
# Password must be at least 12 characters.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Band Admin
INITIAL_BAND_NAME=RehearsalHQ

# Set to 1 when behind exactly one trusted reverse proxy, otherwise 0.
TRUST_PROXY_HOPS=0

# Maximum upload size in MB.
MAX_UPLOAD_MB=100

# Time zone used to interpret rehearsal dates and times for reminders.
# Use an IANA name such as America/Halifax or Europe/London.
TZ=UTC

# Container user/group IDs.
# On Linux, run "id -u" and "id -g" to find your IDs.
# Ensure ./tmp, ./data and ./media are writable by these IDs.
PUID=1000
PGID=1000

# Host port if publishing the application through Docker.
APP_PORT=3000
