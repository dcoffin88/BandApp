# Copy to .env. Do not commit the completed file.
# Must match the browser origin exactly. Use https://band.example.com behind TLS.
APP_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep with your backups: this encrypts the stored SMTP password.
APP_SECRET=

# Used only when creating a new database. Choose a unique password (12+ characters).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Band Admin
INITIAL_BAND_NAME=My Band

# Compose publishes on loopback for a host reverse proxy by default.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
# Exact number of trusted reverse proxy hops (usually 1), otherwise 0.
TRUST_PROXY_HOPS=0
MAX_UPLOAD_MB=100
# Separate audio mount: a named volume by default, or an absolute host directory.
# Host directories must be writable by container UID/GID 1000:1000.
MEDIA_MOUNT=bandapp_media

# For local npm development; Compose sets these inside the container.
PORT=3000
DATA_DIR=./data
MEDIA_DIR=./media
